<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Required on Android 13+ to display notifications, and requested at runtime
      from the Push tab. Declared here rather than in the main source set so the
      default pushOff build does not ask for a permission it can never use.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!--
          Receives Binoban data-only FCM messages and forwards them to the SDK.
          Only registered in the pushOn variant — the class lives in that flavor's
          source set and requires the firebase-messaging dependency.
        -->
        <service
            android:name="io.binoban.sdk.demo.android.push.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
